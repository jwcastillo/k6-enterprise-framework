{
  "name": "stress",
  "description": "Stress testing — arrival-rate open model, ramps to find breaking RPS",
  "executor": "ramping-arrival-rate",
  "stages": [
    {
      "duration": "2m",
      "target": 100
    },
    {
      "duration": "5m",
      "target": 200
    },
    {
      "duration": "5m",
      "target": 400
    },
    {
      "duration": "5m",
      "target": 600
    },
    {
      "duration": "5m",
      "target": 400
    },
    {
      "duration": "3m",
      "target": 0
    }
  ],
  "preAllocatedVUs": 100,
  "maxVUs": 800,
  "thresholds": {
    "http_req_duration": [
      "p(95)<5000",
      "p(99)<10000"
    ],
    "http_req_failed": [
      "rate<0.30"
    ],
    "checks": [
      "rate>=0.70"
    ]
  },
  "maxDuration": "30m"
}
