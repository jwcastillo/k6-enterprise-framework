# Dependencies
node_modules/

# Build output
dist/

# Environment variables
.env
.env.*
!.env.example
!.env.standalone

# Per-client secrets (envs/<client>.env — gitignored; envs/<client>.env.example — tracked)
envs/*.env
!envs/*.env.example

# Client layers (each client lives in its own repo, linked via submodule or CI clone)
clients/*/
!clients/_reference/
!clients/_benchmark/
!clients/examples/

# Reports (generated artifacts)
reports/

# Test coverage
coverage/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Docker secrets files (T-150 — never commit plaintext secrets)
infrastructure/secrets/
infrastructure/docker-compose.override.yml

# Backups
*.bak
*.bak2
*.backup
*.orig

# Generated datasets and test data (large files, local only)
data/

# k6 outputs
k6-results*.json
summary*.json

# Build-regenerated k6 embed entrypoint (regenerated each ./bin/build-binary.sh run; NOT source)
cmd/k6-embedded/entrypoint/go.mod
cmd/k6-embedded/entrypoint/go.sum
cmd/k6-embedded/entrypoint/main.go
# Binario compilado del entrypoint (66 MB, lo produce ./bin/build-binary.sh)
cmd/k6-embedded/entrypoint/k6-entrypoint
# Build-staged client config copied into the embed tree (leaked untracked artifact)
cmd/k6-embedded/scripts/config/

# Logs
*.log

tmp/

# Docusaurus
docs-site/node_modules/
docs-site/build/
docs-site/.docusaurus/